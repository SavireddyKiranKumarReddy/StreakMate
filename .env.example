# StreakMate configuration — copy to .env and fill in.
# .env is gitignored and must never be committed.

# TryHackMe account (used only when the saved Chrome-profile session expires).
# Quote the password if it contains '#' or other shell-special characters.
THM_EMAIL=you@example.com
THM_PASS="your-password"

# Telegram alerts (create a bot with @BotFather, then get your chat id).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=000000000

# Room slug to farm (the part after /room/ in the URL).
THM_ROOM=torforbeginners
